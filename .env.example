############################################################
# Example Environment (.env example)
#
# Copy this file to `.env` and tweak as needed.
############################################################

# =========================
# Backend (Embeddings)
# =========================
# auto | mlx | torch (auto picks MLX on Apple Silicon)
BACKEND=auto
# Default Apple‑Silicon‑friendly embedding model
MODEL_NAME=mlx-community/Qwen3-Embedding-4B-4bit-DWQ
# Optional: local MLX-converted model directory (overrides HF cache)
MODEL_PATH=

# Embedding dimension strategy
# - as_is           → use backend output dimension
# - hidden_size     → use model hidden_size / HF metadata (2560 for Qwen3-Embedding-4B)
# - pad_or_truncate → force OUTPUT_EMBEDDING_DIMENSION (pads or truncates vectors)
DIMENSION_STRATEGY=hidden_size
# OUTPUT_EMBEDDING_DIMENSION=2560  # uncomment + set DIMENSION_STRATEGY=pad_or_truncate to force a fixed size

# LightRAG parity (OpenAI-compatible embeddings):
# - EMBEDDING_SEND_DIM controls whether /v1/embeddings honors the `dimensions` request field.
# - EMBEDDING_TOKEN_LIMIT is a legacy alias for DEFAULT_MAX_TOKENS_OVERRIDE (default per-text preprocessing budget); it can lower the budget, not raise the server/model cap.
# EMBEDDING_SEND_DIM=true
# EMBEDDING_TOKEN_LIMIT=4096

# =========================
# Performance (Embeddings)
# =========================
BATCH_SIZE=32
MAX_BATCH_SIZE=128
MAX_TEXTS_PER_REQUEST=100
MAX_PASSAGES_PER_RERANK=1000
# Positive integer (>=1); default 8192. Embedding server token cap, including
# special tokens. Effective service limit is bounded by backend/server settings
# and discovered model/tokenizer metadata; if metadata is unavailable, use the
# conservative 8192 cap. MLX uses the lower known limit; Torch never expands a
# loaded model's native max_seq_length. The request schema remains capped at
# 8192 even if this setting is higher. Preprocessing estimates tokens as
# len(text)//4; MLX's actual tokenizer performs final truncation. Request-level
# preprocessing overrides take precedence over EMBEDDING_TOKEN_LIMIT (legacy
# alias for DEFAULT_MAX_TOKENS_OVERRIDE), but neither can raise the model/server
# cap. Warnings and processing_info are estimates, not exact backend accounting.
# For the safest long-input tests across API routes, send one text per request.
# BATCH_SIZE=1 alone does not guarantee per-request batching. Set batch_size: 1
# in each OpenAI-compatible or native embedding request; the OpenAI-compatible
# route also accepts X-MLX-Batch-Size: 1. Send one text per TEI request.
MAX_SEQUENCE_LENGTH=8192
DEVICE_MEMORY_FRACTION=0.8
REQUEST_TIMEOUT=300

# =========================
# Reranker (Cross-Encoder) – optional
# =========================
# Enable true cross-encoder reranking by setting a model ID.
# When unset, /api/v1/rerank falls back to embedding-similarity.
RERANKER_BACKEND=auto           # auto | mlx | torch
RERANKER_MODEL_ID=              # e.g. cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL_NAME=          # alias for RERANKER_MODEL_ID
# CROSS_ENCODER_MODEL=          # legacy alias, also accepted

# MLX Qwen3-Reranker operational defaults (positive integers, >=1).
# Pair includes instruction, query, document, system/chat wrappers and suffix.
# Effective pair cap = min(configured cap, known model/tokenizer capacity,
# official Qwen3-Reranker 32768). A checkpoint's 40960 config is not a tested limit.
RERANK_MAX_SEQ_LEN=8192
RERANK_MAX_PASSAGE_TOKENS=6144   # exact MLX document-token cap, NOT characters
RERANK_MAX_PASSAGE_CHARS=65536   # API safety guard per original document, before chunking
RERANK_BATCH_SIZE=1             # conservative on 16 GiB; longer pairs/bigger batches cost memory
# Actual document allowance = min(6144, effective pair cap - tokenized
# instruction/query/wrappers/suffix). Only documents truncate, with numeric warnings;
# queries leaving no document space fail with HTTP 400. Model/score failures are
# server errors, never lexical fallback. MAX_SEQUENCE_LENGTH is embeddings-only.

# Legacy experimental options (not applied by the MLX Qwen3 yes/no scorer):
# - RERANK_POOLING: mean | cls (default: mean)
# - RERANK_SCORE_NORM: none | sigmoid | minmax (default: none)
#   MLX Qwen3 already returns the yes/no softmax probability in [0,1].
RERANK_POOLING=mean
RERANK_SCORE_NORM=none

# =========================
# OpenAI compatibility
# =========================
# Automatically apply sigmoid normalization for OpenAI-compatible rerank scores
# true | false (default true)
OPENAI_RERANK_AUTO_SIGMOID=true

# Cohere-compatible rerank chunking (LightRAG parity)
# Approximate chunk target (1 token ~= 4 chars); NOT the exact MLX token cap.
# Default target is 4096; tune for retrieval semantics, not a universal 8k chunk.
# RERANK_ENABLE_CHUNKING=false
# RERANK_MAX_TOKENS_PER_DOC=4096

# =========================
# Model Cache & Storage
# =========================
# MODEL_PATH: Custom path for MLX models (overrides auto cache detection)
# If empty, uses Hugging Face cache or environment variables below:
# TRANSFORMERS_CACHE: Override HF transformers cache location
# HF_HOME: Hugging Face cache home directory
# Default cache location: ~/.cache/huggingface/hub/
#
# Examples:
# MODEL_PATH=/path/to/local/models/Qwen3-Embedding-4B-4bit-DWQ
# TRANSFORMERS_CACHE=/custom/cache/transformers
# HF_HOME=/custom/huggingface

# =========================
# Server
# =========================
HOST=0.0.0.0
PORT=9000
RELOAD=false

# =========================
# 🚀 Text Processing Defaults
# =========================
# Long text handling is automatic (token-aware). These set the defaults.
DEFAULT_AUTO_TRUNCATE=true
DEFAULT_TRUNCATION_STRATEGY=smart_truncate
# DEFAULT_MAX_TOKENS_OVERRIDE=4096  # optional lower default preprocessing budget; cannot raise the effective cap
DEFAULT_RETURN_PROCESSING_INFO=false

# Text processing strategies:
# - smart_truncate: Preserve sentence boundaries while truncating (recommended)
# - truncate: Simple token-based truncation
# - extract: Extract key sentences only
# - error: Raise error when token limit is exceeded

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =========================
# Security / CORS (optional)
# =========================
# ALLOWED_HOSTS=["example.com","api.example.com"]
# ALLOWED_ORIGINS=["https://example.com","https://app.example.com"]

# Copy this file to `.env` and adjust values for your deployment.
